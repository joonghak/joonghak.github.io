---
import Arrow from '../components/Arrow.astro';
import { profile } from '../data/portfolio';
import { sitePath } from '../lib/paths';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  detail?: boolean;
}
const {
  title = `${profile.name} — 소프트웨어 포트폴리오`,
  description = '이종학의 소프트웨어 포트폴리오. ROS2 반려로봇, Raspberry Pi 게임, 알고리즘과 활동 기록.',
  detail = false,
} = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <link rel="canonical" href={canonical.href} />}
    <link rel="icon" type="image/svg+xml" href={sitePath('favicon.svg')} />
    <link rel="preload" href={sitePath('fonts/PretendardVariable.woff2')} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">본문으로 바로 가기</a>
    <div class="site">
      <header class="site-header">
        <a class="wordmark" href={sitePath()} aria-label="이종학 포트폴리오 홈">{profile.name}<span> / Portfolio</span></a>
        <nav aria-label="페이지 탐색">
          <a href={`${sitePath()}#projects`}>프로젝트</a>
          <a href={`${sitePath()}#awards`}>수상</a>
          <a href={`${sitePath()}#activities`}>활동</a>
          <button type="button" id="print-page">인쇄 / PDF</button>
        </nav>
      </header>
      <main id="content">
        {detail && <a class="back-link" href={`${sitePath()}#projects`}><Arrow direction="left" />모든 프로젝트</a>}
        <slot />
        {detail && <a class="back-link bottom-back" href={sitePath()}><Arrow direction="left" />포트폴리오로 돌아가기</a>}
      </main>
      <footer class="site-footer">
        <p>{profile.name} / Portfolio</p>
        <a href="#content">맨 위로</a>
      </footer>
    </div>
    <script>
      document.getElementById('print-page')?.addEventListener('click', () => window.print());
    </script>
  </body>
</html>
